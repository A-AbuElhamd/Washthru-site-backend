// WashThru backend database schema.
//
// 28 tables across three PostgreSQL schemas (decision #6):
//   cms   content the dashboard edits and the public site reads
//   ops   operational data — leads and the audit trail
//   auth  accounts and sessions
//
// The split is a least-privilege boundary: the public site's database role can
// be granted SELECT on `cms` and INSERT on `ops.contact_submissions` only.
// Free to set up now, awkward to retrofit later.
//
// CONVENTIONS USED THROUGHOUT
// ---------------------------
// * Models are PascalCase and map to snake_case tables; fields are camelCase and
//   map to snake_case columns. TypeScript stays idiomatic, SQL stays idiomatic.
// * Bilingual content is sibling columns (`titleAr` / `titleEn`), never a
//   translations table — decision #4, confirmed there will never be a third
//   language. A child table would add a join to every read for no benefit.
// * `id` is a UUID primary key; `slug` is a SEPARATE unique column (rule 1).
//   This fixes a live bug where `id: payload.slug || crypto.randomUUID()` let a
//   duplicate slug create a duplicate primary key.
// * Soft delete via `deletedAt`, paired with partial unique indexes so a deleted
//   row does not hold its slug hostage (rule 4).
// * `createdBy` / `updatedBy` are plain UUID columns, NOT Prisma relations.
//   Modelling them as relations would need ~50 named relations back to User for
//   a field that is never joined on ("everything Ahmed edited" is a rare query,
//   and rule 5c deliberately skips indexing them). `ops.audit_log` is the real
//   record of who changed what.
// * Image and PDF fields ARE real relations to `MediaAsset` (rule 17). They are
//   joined on every read, and the foreign key stops a file that is still in use
//   from being deleted into a broken image on the live site.

generator client {
  provider = "prisma-client-js"

  // Partial indexes (`@@unique([...], where: raw("deleted_at IS NULL"))`) are
  // still behind a preview flag in Prisma 7.10, despite the documentation
  // describing them as generally available.
  //
  // They are not optional here: rule 4 pairs soft delete with partial unique
  // indexes so a deleted row stops reserving its slug. Without them, deleting a
  // product would permanently block anyone from reusing that slug.
  previewFeatures = ["partialIndexes"]
}

// NOTE: there is deliberately no `url` here.
//
// Prisma 7 removed `url` from the datasource block. The connection string for
// the CLI (migrate, studio, db pull) now lives in `prisma.config.ts` at the
// repo root, and the runtime client gets its connection through a driver
// adapter constructed in `src/prisma.ts`.
//
// Almost every tutorial still shows `url = env("DATABASE_URL")` here, and it
// fails validation with error P1012 on Prisma 7.
datasource db {
  provider = "postgresql"
  schemas  = ["auth", "cms", "ops"]
}

// ---------------------------------------------------------------------------
// Enums
//
// Native Postgres enums for the closed unions that already exist in the
// dashboard's TypeScript (rule 9). A typo becomes a database error instead of a
// blank icon or a broken filter on the live site.
//
// Prisma enum VALUES must be valid identifiers, so the kebab-case strings the
// frontend uses are carried through with @map.
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  editor

  @@map("user_role")
  @@schema("auth")
}

enum MediaKind {
  image
  pdf

  @@map("media_kind")
  @@schema("cms")
}

enum ContentStatus {
  draft
  published

  @@map("content_status")
  @@schema("cms")
}

/// Blueprints are the one content type stored one row per language rather than
/// with sibling columns, so they need an explicit locale.
enum Locale {
  ar
  en

  @@map("locale")
  @@schema("cms")
}

enum AuditAction {
  create
  update
  delete

  @@map("audit_action")
  @@schema("ops")
}

enum ContactRequestType {
  inquiry
  complaint
  consultation
  purchase
  maintenance

  @@map("contact_request_type")
  @@schema("ops")
}

enum ProductCategory {
  touchless
  rollover
  tunnel

  @@map("product_category")
  @@schema("cms")
}

/// All five values are seeded even though four currently have no articles —
/// the six news items that carried the other categories were deleted from the
/// site. The schema should not narrow itself to today's content.
enum NewsCategory {
  productLaunches        @map("product-launches")
  partnershipsContracts  @map("partnerships-contracts")
  exhibitionsEvents      @map("exhibitions-events")
  achievementsExpansions @map("achievements-expansions")
  inMedia                @map("in-media")

  @@map("news_category")
  @@schema("cms")
}

enum BlueprintPlanType {
  station
  serviceCenter @map("service-center")

  @@map("blueprint_plan_type")
  @@schema("cms")
}

enum BlueprintStreetConfig {
  oneStreet           @map("one-street")
  twoStreetsBefore    @map("two-streets-before")
  twoStreetsAfter     @map("two-streets-after")
  twoStreetsBehind    @map("two-streets-behind")
  threeStreetsBefore  @map("three-streets-before")
  threeStreetsAfter   @map("three-streets-after")
  threeStreetsBehind  @map("three-streets-behind")
  fourStreets         @map("four-streets")

  @@map("blueprint_street_config")
  @@schema("cms")
}

/// Icon names rather than data, but a closed set in the dashboard's TypeScript,
/// so they get the same protection.
enum ServiceIcon {
  ClipboardList
  Ruler
  HardHat
  GraduationCap
  Calculator
  Headphones
  Wrench
  RefreshCcw

  @@map("service_icon")
  @@schema("cms")
}

enum ValueIcon {
  Award
  Lightbulb
  HeartHandshake

  @@map("value_icon")
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// auth — accounts and sessions
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(200)

  /// Present but NOT enforced anywhere yet (decision #12). Every user is
  /// effectively an admin today. The column exists because adding it now is one
  /// line, whereas adding it later is a migration plus a backfill plus an audit
  /// of every endpoint. The likely first use is restricting
  /// `ops.contact_submissions`, which holds customer names, phones and emails.
  role UserRole @default(editor)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditEntries  AuditLog[]
  uploads       MediaAsset[]

  /// Partial unique: a deleted user must not keep their address reserved.
  @@unique([email], where: raw("deleted_at IS NULL"), map: "users_email_active_key")
  @@map("users")
  @@schema("auth")
}

/// One row per issued refresh token.
///
/// This table is what makes logout and revocation possible at all. A JWT is
/// valid until it expires and the server cannot take it back, so the access
/// token is kept short (~15 min) and the long-lived half lives here — deleting
/// the row ends the session (decision #12).
model RefreshToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The token's HASH, never the token itself. A stolen database backup must not
  /// hand over working sessions.
  tokenHash String @unique @map("token_hash") @db.Text

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hit on every token refresh — Postgres does not index foreign keys itself.
  @@index([userId])
  @@map("refresh_tokens")
  @@schema("auth")
}

// ---------------------------------------------------------------------------
// ops — inbound data and the audit trail
// ---------------------------------------------------------------------------

/// Contact form submissions.
///
/// The only table here holding real customer personal data, and the only one
/// written by anonymous public visitors. Nothing in it is bilingual — it is
/// inbound data, not content.
///
/// ⚠️ PDPL: name, phone and email are personal data. These values must never be
/// written to logs (decision #15, rule 3).
model ContactSubmission {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType ContactRequestType @map("request_type")

  name  String @db.VarChar(200)
  city  String @db.VarChar(120)
  phone String @db.VarChar(40)
  email String @db.VarChar(255)

  /// Was `'yes' | 'no'` in the dashboard's TypeScript; a two-value string union
  /// is just a boolean wearing a hat.
  hasCarWash Boolean @map("has_car_wash")

  /// Optional on the real form, so genuinely nullable.
  message String? @db.Text

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  /// The dashboard lists newest first, and this table grows forever.
  @@index([submittedAt(sort: Desc)])
  @@map("contact_submissions")
  @@schema("ops")
}

/// Who changed what, and what it looked like before.
///
/// `before` / `after` as jsonb is the one place in this schema where jsonb is
/// unambiguously correct: the shape genuinely varies by table (rule 8).
model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableName String      @map("table_name") @db.VarChar(120)
  recordId  String      @map("record_id") @db.Uuid
  action    AuditAction

  before Json? @db.JsonB
  after  Json? @db.JsonB

  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// "History of this record" and "what changed recently" are the two queries
  /// this table exists to answer.
  @@index([tableName, recordId])
  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_log")
  @@schema("ops")
}

// ---------------------------------------------------------------------------
// cms — shared infrastructure
// ---------------------------------------------------------------------------

/// Every image and PDF in the system.
///
/// Binaries are NEVER stored in Postgres (rule 7) — the bytes live in Azure Blob
/// Storage and this table holds the path plus metadata.
///
/// `blobPath` stores the path WITHIN the container, not a full URL. Storing full
/// URLs is what makes a CDN or domain change a rewrite of every row; storing
/// paths makes it a config change. The API composes the URL on read.
///
/// This table replaces the 218 files currently served from a Webflow CDN
/// WashThru does not own, and the PDF "uploads" that are browser blob URLs and
/// die on refresh.
model MediaAsset {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blobPath String @unique @map("blob_path") @db.VarChar(500)

  /// The name the file was uploaded with — this is `ImageFileRef.fileName`,
  /// which the dashboard already displays.
  originalFilename String    @map("original_filename") @db.VarChar(400)
  mimeType         String    @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt    @map("size_bytes")
  kind             MediaKind

  /// Images only; null for PDFs.
  width  Int?
  height Int?

  /// Paths to the generated sizes (thumb / card / full). Kept as jsonb rather
  /// than three columns because the set of sizes is a rendering decision that
  /// may change, and a change of shape should not require a migration.
  variants Json? @db.JsonB

  /// Content hash, so re-uploading the same file can be detected.
  checksum String? @db.VarChar(128)

  uploadedBy String?   @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  // Back-relations. Verbose, but each one is a real foreign key that stops a
  // file still in use from being deleted into a broken image.
  homeFeatureIcons        HomeFeature[]          @relation("HomeFeatureIcon")
  homeFeatureBackgrounds  HomeFeature[]          @relation("HomeFeatureBackground")
  homeTestimonialIcons    HomeTestimonial[]      @relation("HomeTestimonialIcon")
  homePartnerImages       HomePartner[]          @relation("HomePartnerImage")
  teamMemberPhotos        TeamMember[]           @relation("TeamMemberPhoto")
  productHeroImages       Product[]              @relation("ProductHeroImage")
  productPdfsAr           Product[]              @relation("ProductPdfAr")
  productPdfsEn           Product[]              @relation("ProductPdfEn")
  productCarouselImages   ProductCarouselImage[] @relation("ProductCarouselImage")
  serviceItemIcons        ServiceItem[]          @relation("ServiceItemIcon")
  serviceItemBackgrounds  ServiceItem[]          @relation("ServiceItemBackground")
  knowledgePdfsAr         KnowledgeResource[]    @relation("KnowledgePdfAr")
  knowledgePdfsEn         KnowledgeResource[]    @relation("KnowledgePdfEn")
  blueprintImages         BlueprintPlan[]        @relation("BlueprintImage")
  blueprintDrawings       BlueprintPlan[]        @relation("BlueprintDrawing")
  blueprintFooterCovers   BlueprintPlan[]        @relation("BlueprintFooterCover")
  blueprintPdfs           BlueprintPlan[]        @relation("BlueprintPdf")
  blogCoverImages         BlogPost[]             @relation("BlogCoverImage")
  newsCoverImages         NewsArticle[]          @relation("NewsCoverImage")

  @@index([uploadedBy])
  @@map("media_assets")
  @@schema("cms")
}

/// All one-row page copy blocks, in ONE table (decision #7).
///
/// The dashboard has 11 `useFieldStore` blocks — home hero, who-we-are teaser,
/// product highlights, and a hero for each of products / wash-cloud /
/// knowledge-library / blueprints / blog / news / contact-us.
///
/// Option 1 of the original design gave each its own table: 10 tables holding
/// exactly one row forever, and a migration every time a piece of copy changed
/// shape. This is 11 rows instead, with `content` holding the exact
/// `LocalizedText` tree the dashboard's TypeScript already uses — so there is no
/// conversion layer to learn.
model PageContent {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "home", "products", "blog"
  page  String @db.VarChar(80)
  /// e.g. "hero", "whoWeAreTeaser", "productHighlights"
  block String @db.VarChar(80)

  content Json @db.JsonB

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([page, block])
  @@map("page_content")
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// cms — home page
//
// These list tables carry `sortOrder`, which is net-new: the dashboard has no
// ordering at all today. They do NOT carry `status` / `publishedAt` — per rule 3
// those belong only to the five real content types (products, blog, news,
// blueprints, knowledge resources).
// ---------------------------------------------------------------------------

model HomeFeature {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descriptionAr String @map("description_ar") @db.Text
  descriptionEn String @map("description_en") @db.Text

  iconId            String? @map("icon_id") @db.Uuid
  backgroundImageId String? @map("background_image_id") @db.Uuid

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  icon            MediaAsset? @relation("HomeFeatureIcon", fields: [iconId], references: [id], onDelete: Restrict)
  backgroundImage MediaAsset? @relation("HomeFeatureBackground", fields: [backgroundImageId], references: [id], onDelete: Restrict)

  @@map("home_features")
  @@schema("cms")
}

model HomeService {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr       String      @map("title_ar") @db.VarChar(300)
  titleEn       String      @map("title_en") @db.VarChar(300)
  descriptionAr String      @map("description_ar") @db.Text
  descriptionEn String      @map("description_en") @db.Text
  icon          ServiceIcon

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("home_services")
  @@schema("cms")
}

model HomeTestimonial {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Single-value: a person's name is not translated. Note this is deliberately
  /// inconsistent with `BlogPost.authorName`, which IS bilingual — rule 16 says
  /// follow the existing data rather than normalising it.
  name String @db.VarChar(200)

  quoteAr String @map("quote_ar") @db.Text
  quoteEn String @map("quote_en") @db.Text
  iconId  String? @map("icon_id") @db.Uuid

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  icon MediaAsset? @relation("HomeTestimonialIcon", fields: [iconId], references: [id], onDelete: Restrict)

  @@map("home_testimonials")
  @@schema("cms")
}

/// A partner is a logo and a position. That is genuinely the whole record.
model HomePartner {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId String? @map("image_id") @db.Uuid

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  image MediaAsset? @relation("HomePartnerImage", fields: [imageId], references: [id], onDelete: Restrict)

  @@map("home_partners")
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// cms — who we are
// ---------------------------------------------------------------------------

model CompanyValue {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr       String    @map("title_ar") @db.VarChar(300)
  titleEn       String    @map("title_en") @db.VarChar(300)
  descriptionAr String    @map("description_ar") @db.Text
  descriptionEn String    @map("description_en") @db.Text
  icon          ValueIcon

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("company_values")
  @@schema("cms")
}

model CompanyMilestone {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Text, not an integer — the existing data is free-form and a range like
  /// "2019–2020" must stay valid.
  year String @db.VarChar(40)

  descriptionAr String @map("description_ar") @db.Text
  descriptionEn String @map("description_en") @db.Text

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("company_milestones")
  @@schema("cms")
}

/// No icon field — goals do not have one.
model CompanyGoal {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descriptionAr String @map("description_ar") @db.Text
  descriptionEn String @map("description_en") @db.Text

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("company_goals")
  @@schema("cms")
}

model TeamMember {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Single-value: a person's name is not translated. The job TITLE is.
  name    String  @db.VarChar(200)
  titleAr String  @map("title_ar") @db.VarChar(300)
  titleEn String  @map("title_en") @db.VarChar(300)
  photoId String? @map("photo_id") @db.Uuid

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  photo MediaAsset? @relation("TeamMemberPhoto", fields: [photoId], references: [id], onDelete: Restrict)

  @@map("team_members")
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// cms — products
// ---------------------------------------------------------------------------

/// The three product categories and their page copy. Three rows, forever.
///
/// This one is filed as a `useFieldStore` in the dashboard, which made it look
/// like page copy — but it holds `Record<ProductCategory, ProductCategoryContent>`,
/// i.e. three keyed rows each with a nested list. It is structurally a table.
model ProductCategoryContent {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category ProductCategory @unique

  titleAr     String @map("title_ar") @db.VarChar(300)
  titleEn     String @map("title_en") @db.VarChar(300)
  typeLabelAr String @map("type_label_ar") @db.VarChar(200)
  typeLabelEn String @map("type_label_en") @db.VarChar(200)

  descriptionAr String @map("description_ar") @db.Text
  descriptionEn String @map("description_en") @db.Text

  expandedTitleAr       String @map("expanded_title_ar") @db.VarChar(300)
  expandedTitleEn       String @map("expanded_title_en") @db.VarChar(300)
  expandedDescriptionAr String @map("expanded_description_ar") @db.Text
  expandedDescriptionEn String @map("expanded_description_en") @db.Text

  /// Nested `CategoryItem[]` — title + description per item. Stays inside the
  /// parent row (decision #7): nothing ever queries these across categories.
  items Json @db.JsonB

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("product_categories")
  @@schema("cms")
}

model Product {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Separate from `id` (rule 1). The live dashboard does
  /// `id: payload.slug || crypto.randomUUID()`, which lets a duplicate slug
  /// create a duplicate primary key. The unique index below is the fix.
  slug String @db.VarChar(200)

  category ProductCategory

  titleAr     String @map("title_ar") @db.VarChar(300)
  titleEn     String @map("title_en") @db.VarChar(300)
  subtitleAr  String @map("subtitle_ar") @db.VarChar(400)
  subtitleEn  String @map("subtitle_en") @db.VarChar(400)
  typeLabelAr String @map("type_label_ar") @db.VarChar(200)
  typeLabelEn String @map("type_label_en") @db.VarChar(200)

  /// Multi-paragraph, blank-line joined — as the site already stores it.
  descriptionAr String @map("description_ar") @db.Text
  descriptionEn String @map("description_en") @db.Text

  heroImageId String? @map("hero_image_id") @db.Uuid

  /// Was `pdfUrl: LocalizedText` — a bilingual URL *string*. Now two real
  /// foreign keys (rule 17), matching how knowledge-library PDFs are modelled.
  pdfArId String? @map("pdf_ar_id") @db.Uuid
  pdfEnId String? @map("pdf_en_id") @db.Uuid

  /// Nested lists that stay in the parent row: they are edited as a block on the
  /// product form and never queried across products. `quickInfo` items have no
  /// id at all, so nothing is lost by inlining them.
  quickInfo Json @map("quick_info") @db.JsonB
  videos    Json @db.JsonB

  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  heroImage MediaAsset? @relation("ProductHeroImage", fields: [heroImageId], references: [id], onDelete: Restrict)
  pdfAr     MediaAsset? @relation("ProductPdfAr", fields: [pdfArId], references: [id], onDelete: Restrict)
  pdfEn     MediaAsset? @relation("ProductPdfEn", fields: [pdfEnId], references: [id], onDelete: Restrict)

  testimonials   ProductTestimonial[]
  carouselImages ProductCarouselImage[]

  @@unique([slug], where: raw("deleted_at IS NULL"), map: "products_slug_active_key")
  @@index([status, publishedAt(sort: Desc)])
  @@map("products")
  @@schema("cms")
}

/// The "+" in "Option 3+".
///
/// The ONLY nested list promoted to its own table, because it is the only one
/// the public site queries ACROSS records: `getAllProductTestimonials()` feeds
/// the reviews section on /our-products by pulling testimonials from every
/// product at once. That is impossible if they are buried in each product row.
model ProductTestimonial {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Single-value, like the home-page testimonials.
  name    String @db.VarChar(200)
  quoteAr String @map("quote_ar") @db.Text
  quoteEn String @map("quote_en") @db.Text

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_testimonials")
  @@schema("cms")
}

/// A product's carousel photos, as rows rather than an array of ids in jsonb.
///
/// Chosen deliberately. As jsonb, adding one photo means rewriting the whole
/// array: a drag-reorder rewrites everything, and two people editing at once
/// silently overwrite each other. As a table it is an ordinary ordered list, so
/// it registers against the generic CRUD layer (decision #8) and gets
/// add / remove / reorder for free instead of hand-written endpoints.
///
/// It also restores the foreign key, so a photo still in use cannot be deleted
/// into a broken image on the live site.
model ProductCarouselImage {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String @map("product_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation("ProductCarouselImage", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  /// Joined on every product read; Postgres does not index foreign keys itself.
  @@index([productId])
  @@index([mediaAssetId])
  @@map("product_carousel_images")
  @@schema("cms")
}

