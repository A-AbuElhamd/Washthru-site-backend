/// The four fixed pricing tiers.
///
/// ⚠️ EVERY OPTIONAL FIELD HERE IS GENUINELY NULLABLE (rule 12).
///
/// The dashboard currently uses an empty pair `{ ar: '', en: '' }` to mean
/// "nothing" — no tagline, no bonus, or a "Contact us" tier with no price.
/// Carried across as empty strings, every "is this set?" check would silently
/// pass. The migration must convert those to real NULLs.
model PlanTier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  nameLine1Ar String @map("name_line1_ar") @db.VarChar(200)
  nameLine1En String @map("name_line1_en") @db.VarChar(200)
  nameLine2Ar String @map("name_line2_ar") @db.VarChar(200)
  nameLine2En String @map("name_line2_en") @db.VarChar(200)

  taglineAr String? @map("tagline_ar") @db.VarChar(400)
  taglineEn String? @map("tagline_en") @db.VarChar(400)

  priceMonthlyAr      String? @map("price_monthly_ar") @db.VarChar(120)
  priceMonthlyEn      String? @map("price_monthly_en") @db.VarChar(120)
  priceAnnualAr       String? @map("price_annual_ar") @db.VarChar(120)
  priceAnnualEn       String? @map("price_annual_en") @db.VarChar(120)
  priceAnnualStrikeAr String? @map("price_annual_strike_ar") @db.VarChar(120)
  priceAnnualStrikeEn String? @map("price_annual_strike_en") @db.VarChar(120)

  bonusMonthlyAr String? @map("bonus_monthly_ar") @db.Text
  bonusMonthlyEn String? @map("bonus_monthly_en") @db.Text
  bonusAnnualAr  String? @map("bonus_annual_ar") @db.Text
  bonusAnnualEn  String? @map("bonus_annual_en") @db.Text

  /// Feature rows (text plus an optional detail popover) and the discount list.
  /// Both edited as a block on the tier form, never queried across tiers.
  features  Json @db.JsonB
  discounts Json @db.JsonB

  highlighted Boolean @default(false)

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("plan_tiers")
  @@schema("cms")
}

// ---------------------------------------------------------------------------
// cms — blog, news and tags
//
// Written against a fresh audit of both repositories (2026-09-17). Note the
// site stores these as one file per locale with a `(slug, locale)` key, while
// the dashboard stores them bilingually. The sibling-column form below follows
// the dashboard, since that is what edits the data; the API splits them per
// locale on the way out.
// ---------------------------------------------------------------------------

model BlogPost {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @db.VarChar(250)

  /// These four, plus `slug` and `publishedAt`, are the only fields the
  /// dashboard actually validates — so they are the honest NOT NULL set.
  /// Everything else is nullable by design, not by oversight.
  titleAr       String @map("title_ar") @db.VarChar(400)
  titleEn       String @map("title_en") @db.VarChar(400)
  descriptionAr String @map("description_ar") @db.Text
  descriptionEn String @map("description_en") @db.Text

  /// One cover image shared across both languages; the ALT TEXT is per-language.
  coverImageId    String? @map("cover_image_id") @db.Uuid
  coverImageAltAr String? @map("cover_image_alt_ar") @db.VarChar(500)
  coverImageAltEn String? @map("cover_image_alt_en") @db.VarChar(500)

  /// Bilingual in shape, but in practice always the brand ("واش ثرو" /
  /// "WashThru") — never a person. Kept bilingual because that is what the data
  /// is (rule 16).
  authorNameAr String? @map("author_name_ar") @db.VarChar(200)
  authorNameEn String? @map("author_name_en") @db.VarChar(200)

  /// DATE, not timestamptz: every value in both repositories is `YYYY-MM-DD`
  /// with no time and no timezone. Storing it as a timestamp would invent a
  /// midnight that then shifts around by timezone.
  publishedAt DateTime @map("published_at") @db.Date

  /// The editorial "last updated" date. Named to avoid colliding with the
  /// `updatedAt` audit column. Empty on all 19 dashboard posts and absent from
  /// all 38 site files, but the site DOES read it for SEO `dateModified`.
  contentUpdatedAt DateTime? @map("content_updated_at") @db.Date

  /// The only bilingual pair of NUMBERS in the schema. They genuinely differ on
  /// 13 of 19 posts, so a single shared column would be wrong.
  ///
  /// ⚠️ Recompute these from the real HTML during migration — six posts carry
  /// 1–2 minutes because their bodies were empty when the seed was generated.
  readingMinutesAr Int? @map("reading_minutes_ar")
  readingMinutesEn Int? @map("reading_minutes_en")

  noindex Boolean @default(false)

  contentHtmlAr String? @map("content_html_ar") @db.Text
  contentHtmlEn String? @map("content_html_en") @db.Text

  status ContentStatus @default(draft)

  sortOrder Int       @map("sort_order") @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  coverImage MediaAsset?   @relation("BlogCoverImage", fields: [coverImageId], references: [id], onDelete: Restrict)
  tags       BlogPostTag[]

  @@unique([slug], where: raw("deleted_at IS NULL"), map: "blog_posts_slug_active_key")
  /// Exactly the blog index page's query.
  @@index([status, publishedAt(sort: Desc)])
  @@map("blog_posts")
  @@schema("cms")
}

model NewsArticle {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @db.VarChar(250)

  titleAr   String @map("title_ar") @db.VarChar(400)
  titleEn   String @map("title_en") @db.VarChar(400)
  excerptAr String @map("excerpt_ar") @db.Text
  excerptEn String @map("excerpt_en") @db.Text

  category NewsCategory

  coverImageId    String? @map("cover_image_id") @db.Uuid
  coverImageAltAr String? @map("cover_image_alt_ar") @db.VarChar(500)
  coverImageAltEn String? @map("cover_image_alt_en") @db.VarChar(500)

  /// DATE, as with blog posts.
  publishedAt DateTime @map("published_at") @db.Date

  /// Drives the top carousel instead of the card grid. No current article sets
  /// it — both that did were among the six deleted from the site — but the
  /// column stays, because the schema should not narrow to today's content.
  featured Boolean @default(false)

  /// ⚠️ These bodies embed their own images: inline-styled gallery divs with
  /// hardcoded `<img src="/images/news/<slug>/….png">`. The Webflow migration
  /// must rewrite images INSIDE this HTML, not just the cover image column.
  contentHtmlAr String? @map("content_html_ar") @db.Text
  contentHtmlEn String? @map("content_html_en") @db.Text

  status ContentStatus @default(draft)

  sortOrder Int       @map("sort_order") @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  coverImage MediaAsset? @relation("NewsCoverImage", fields: [coverImageId], references: [id], onDelete: Restrict)

  @@unique([slug], where: raw("deleted_at IS NULL"), map: "news_articles_slug_active_key")
  @@index([status, publishedAt(sort: Desc)])
  /// The index page's tab bar filters on this.
  @@index([category])
  @@map("news_articles")
  @@schema("cms")
}

/// Blog tags.
///
/// The dashboard edits these as a comma-separated string today, which is why
/// near-duplicates have accumulated (`car-wash` vs `car-wash-business`,
/// `technology` vs `car-wash-technology`). Canonicalise before seeding — merging
/// is cheap now and becomes a data migration once join rows point at them.
///
/// `slug` is the English kebab-case identifier used in the content files. The
/// labels are nullable because tags are not displayed anywhere yet — they feed
/// related-post matching and OG `article:tag` meta only.
model Tag {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug    String  @unique @db.VarChar(120)
  labelAr String? @map("label_ar") @db.VarChar(200)
  labelEn String? @map("label_en") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts BlogPostTag[]

  @@map("tags")
  @@schema("cms")
}

/// Join table (rule 6).
model BlogPostTag {
  blogPostId String @map("blog_post_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  /// The composite primary key already indexes `blogPostId`; this side needs its
  /// own index for "find every post with this tag".
  @@index([tagId])
  @@map("blog_post_tags")
  @@schema("cms")
}

