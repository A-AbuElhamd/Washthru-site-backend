/// The one content type that is NOT bilingual per field.
///
/// The dashboard's own type comment says it: "unlike every other content type in
/// this dashboard, a plan is NOT bilingual per field... `locale` picks which
/// language this specific plan's text is written in." So it is one row per
/// language, keyed on (slug, locale) — matching `content/blueprints/{locale}/`.
///
/// All six existing plans are Arabic. English blueprints do not exist yet; the
/// unique key already supports adding them later with no migration.
///
/// Note the blueprints HERO *is* bilingual — it lives in `page_content`, so the
/// two do not get confused.
model BlueprintPlan {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug   String @db.VarChar(200)
  locale Locale

  /// Plain columns, not `_ar` / `_en` — see the note above.
  title String @db.VarChar(300)
  intro String @db.Text

  planNumber       String @map("plan_number") @db.VarChar(80)
  measurementLabel String @map("measurement_label") @db.VarChar(200)
  areaLabel        String @map("area_label") @db.VarChar(200)
  ideaLabel        String @map("idea_label") @db.VarChar(200)

  planType     BlueprintPlanType     @map("plan_type")
  streetConfig BlueprintStreetConfig @map("street_config")

  sketchfabEmbedUrl String? @map("sketchfab_embed_url") @db.VarChar(1000)

  imageId            String? @map("image_id") @db.Uuid
  drawingImageId     String? @map("drawing_image_id") @db.Uuid
  footerCoverImageId String? @map("footer_cover_image_id") @db.Uuid
  pdfId              String? @map("pdf_id") @db.Uuid

  /// Nested feature list — title, description and image per feature. No ids, so
  /// nothing is lost by keeping it in the parent row.
  features Json @db.JsonB

  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)

  sortOrder Int       @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  image            MediaAsset? @relation("BlueprintImage", fields: [imageId], references: [id], onDelete: Restrict)
  drawingImage     MediaAsset? @relation("BlueprintDrawing", fields: [drawingImageId], references: [id], onDelete: Restrict)
  footerCoverImage MediaAsset? @relation("BlueprintFooterCover", fields: [footerCoverImageId], references: [id], onDelete: Restrict)
  pdf              MediaAsset? @relation("BlueprintPdf", fields: [pdfId], references: [id], onDelete: Restrict)

  @@unique([slug, locale], where: raw("deleted_at IS NULL"), map: "blueprint_plans_slug_locale_active_key")
  @@index([status, publishedAt(sort: Desc)])
  @@map("blueprint_plans")
  @@schema("cms")
}

