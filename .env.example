# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this example file is committed.
#
# Every variable here is validated at startup by src/config.ts — if one is
# missing or malformed the server refuses to boot and says which. That is
# deliberate: a misconfigured server should fail loudly at 9am, not silently
# at 3am.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000

# --- Logging ---------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=debug

# --- CORS (decision #18) ---------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# A wildcard is NOT possible: the auth cookie makes every request credentialed,
# and browsers reject `Access-Control-Allow-Origin: *` on those.
# Include the dashboard, the public site, and localhost ports while developing.
#
# REQUIRED in production — left empty there, every browser request is blocked
# and the only symptom is a CORS error that says nothing about the cause.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Reverse proxy ---------------------------------------------------------
# How many proxy hops to trust for the real client IP (X-Forwarded-For).
#   0  running directly, no proxy        <- correct locally
#   1  behind Azure App Service          <- set this on Azure
#
# Getting it wrong breaks IP rate limiting in one of two ways, silently:
#   too low  -> every visitor looks like the proxy, so one limit for the world
#   too high -> clients can forge their own IP and bypass the limit entirely
TRUST_PROXY_HOPS=0

# --- Auth ------------------------------------------------------------------
# Signing secret for access tokens. Minimum 32 characters, enforced at boot.
# Generate with: openssl rand -base64 48
# On Azure this belongs in App Service config or Key Vault, never in a file.
# JWT_SECRET=

# Optional. Defaults: 15 minutes and 30 days.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Database (used from Session 2 onward) ---------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/washthru_dev

# --- Auth (used from Session 4 onward) -------------------------------------
# Long random string. Generate with: openssl rand -base64 48
# JWT_SECRET=
